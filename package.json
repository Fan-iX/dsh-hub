{
  "name": "dsh-hub",
  "version": "0.1.0",
  "description": "A JupyterHub-style multi-user front and a single-user reverse proxy for DeepSeek Harness (dsh): PAM login, per-user isolated instances (hub) or one account-managed instance (proxy), HTTP/WebSocket proxy. Zero dsh modifications.",
  "type": "module",
  "main": "src/hub/index.mjs",
  "scripts": {
    "start": "node src/hub/index.mjs",
    "start:proxy": "node src/proxy/index.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "http-proxy": "^1.18.0"
  },
  "optionalDependencies": {
    "node-linux-pam": "^0.2.1",
    "node-pty": "^1.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mpaperlee/dsh-hub.git"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "jupyterhub",
    "multi-user",
    "pam",
    "proxy"
  ]
}
